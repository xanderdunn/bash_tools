# Machine-global gitignore (git config core.excludesfile).
#
# RULE: editor/OS junk ONLY — never patterns that could match a file a repo
# intentionally tracks. Broad type patterns here (*.json, *.sql, *.log, build
# outputs, tool configs) silently exclude new files from `git add -A` and
# cause stash/restore cycles (e.g. pre-commit hooks) to drop tracked files
# from the index, recording them as deletions. This bit for real (2026-07).
# Language/build/tool ignores belong in each repo's own .gitignore.

# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db

# Vim swap/backup files
*.swp
*.swo
*.swn
*~

.vim-session.vim
